# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets or the DB password.

ANTHROPIC_API_KEY=sk-ant-your-key-here
EBAY_API_KEY=your-ebay-key-here
FLASK_TAILSCALE_IP=100.111.112.8

# Local Postgres (Week 1 multi-user foundation). The password lives ONLY in .env,
# never in any .py file. Local dev server runs on port 5433 (see README/setup).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/bourbon_hunter
